# Copy this file to `.env` and replace each placeholder with a real value.
# Never commit your real `.env` file to git.

# --- Database -------------------------------------------------------------
# With the provided docker-compose.yml, PostgreSQL is exposed on host port 5433.
# The driver must be asyncpg. URL-encode special characters in the password
# (e.g. @ -> %40). Supabase: use the session pooler with ?ssl=require.
DATABASE_URL=postgresql+asyncpg://autohire:autohire@localhost:5433/autohire
# Used by pytest only. The database name MUST end in `_test`.
TEST_DATABASE_URL=postgresql+asyncpg://autohire:autohire@localhost:5433/autohire_test

# --- Secrets --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars-long
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-44-character-fernet-key-here-xxxxxxx=

# --- Auth -----------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Booking rules --------------------------------------------------------
HOLD_MINUTES=30
TURNAROUND_BUFFER_MINUTES=60

# --- Pricing (integer KES) ------------------------------------------------
VAT_PERCENT=16
BABY_SEAT_KES_PER_DAY=500
ROOFTOP_TENT_KES_PER_DAY=2500
COOLER_BOX_KES_PER_DAY=300
AIRPORT_PICKUP_KES=1500
DRIVER_FEE_IN_TOWN_KES_PER_DAY=2500
DRIVER_FEE_UPCOUNTRY_KES_PER_DAY=4000
CHAUFFEUR_DEPOSIT_PERCENT=50

# --- Handover / overdue ---------------------------------------------------
LATE_FEE_GRACE_MINUTES=120
LATE_FEE_PER_HOUR_KES=500
EXCESS_MILEAGE_KES_PER_KM=50

# --- Login rate limiting (in-process, per worker) -------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Safaricom Daraja (M-Pesa) -------------------------------------------
# Create an app at https://developer.safaricom.co.ke
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/api/v1/payments/mpesa/callback
# Paybill: CustomerPayBillOnline. Buy Goods (Till): CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# --- SMS notifications (Africa's Talking) ---------------------------------
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
